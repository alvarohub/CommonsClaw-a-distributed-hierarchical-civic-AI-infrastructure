[Unit]
Description=SSAI web chat server
After=ollama.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/ssai
# Wait until Ollama answers before starting the web server.
ExecStartPre=/bin/sh -c 'until curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/python3 /home/admin/ssai/web_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
