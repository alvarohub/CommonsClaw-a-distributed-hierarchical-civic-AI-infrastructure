[Unit]
Description=CommonsClaw voice loop (USB mic, controlled from the web page)
After=multi-user.target sound.target

[Service]
Type=simple
User=admin
SupplementaryGroups=audio
WorkingDirectory=/home/admin/commonsclaw
ExecStart=/home/admin/voice-venv/bin/python /home/admin/commonsclaw/voice/talk.py --serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
